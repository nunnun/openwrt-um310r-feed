#!/bin/sh
# NEC uM310R / AM Telecom AMM570 helper, next to ModemManager.
#
# ModemManager owns the data connection (MBIM, netifd proto "modemmanager") and
# SMS. This daemon is the only user of the card's AT port, which ModemManager
# ignores (77-mm-um310r.rules), and adds what ModemManager cannot do here:
#  - LTE details for LuCI and the ANT LED (band, EARFCN, PCI, TAC/cell, level)
#  - the correct IMEI (the card's MBIM device id has a wrong check digit)
#  - SIM SMS storage usage (a full SIM rejects new messages)
#  - recovery: wwan left down by netifd -> ifup; ModemManager without the modem
#    or stuck on a dead MBIM channel -> reset it; card not answering at all ->
#    power-cycle it
#
#   um310r-modem daemon                  poll every 10 s, recover when needed
#   um310r-modem status                  print the last status (key=value)
#   um310r-modem sms-list                list SMS (ModemManager)
#   um310r-modem sms-del <id|all>        delete SMS by ModemManager id
#   um310r-modem sms-send <num> <text>   send an SMS (UTF-8, max 70 characters)
#
# Status is written to /var/run/um310r-modem/status for the LED daemon and LuCI.

RUN=/var/run/um310r-modem
LOCK=$RUN/at.lock
IFACE=wwan
mkdir -p $RUN

log() { logger -t um310r-modem "$*"; }

# AT port = the ttyUSB of USB interface 3 (same in ACM 0202 and MBIM 0209 mode)
at_port() {
	local t
	for t in /sys/bus/usb/devices/*:1.3/ttyUSB*; do
		[ -e "$t" ] || continue
		[ "$(cat ${t%/*}/../idVendor 2>/dev/null)" = 1ecb ] && { echo /dev/${t##*/}; return 0; }
	done
	return 1
}

# at_raw TIMEOUT STRING : send STRING (no CR added), print the reply (CR stripped).
# Returns as soon as a final result line (OK / ERROR / +CME|+CMS ERROR) arrives,
# or after TIMEOUT seconds. The port is already open for reading on fd 8, so
# nothing the card sends right after the write is lost. Caller holds the lock.
at_raw() {
	local out=$RUN/at.$$
	(timeout "$1" awk '{ sub(/\r$/, ""); print } /^(OK|ERROR|\+CM[ES] ERROR.*)$/ { exit }' <&8 > $out 2>/dev/null) &
	printf '%s' "$2" > "$AT"
	wait
	tr -d '\r' < $out
	rm -f $out
}

# at_open [LOCKWAIT] : take the AT lock (shared with the 20-amm570 hotplug)
at_open() {
	AT=$(at_port) || return 1
	# no host-side echo: with card echo on, the two would ping-pong
	stty -F "$AT" raw -echo -echoe -echok -echoctl -echoke 115200 2>/dev/null
	exec 9>$LOCK
	timeout "${1:-30}" flock 9 2>/dev/null || { exec 9>&-; return 1; }	# busybox flock has no -w
	exec 8<"$AT" || { at_close; return 1; }
	at_raw 2 "ATE0"$'\r' >/dev/null	# card echo comes back after every card reboot
	return 0
}

at_close() { exec 8<&- 2>/dev/null; flock -u 9 2>/dev/null; exec 9>&-; }

# AT <command> [timeout] (between at_open/at_close)
AT() { at_raw "${2:-2}" "$1"$'\r'; }

earfcn_band() {
	local e=$1
	[ -n "$e" ] || return
	if   [ $e -lt 600 ];  then echo 1
	elif [ $e -lt 1200 ]; then echo 2
	elif [ $e -lt 1950 ]; then echo 3
	elif [ $e -lt 2400 ]; then echo 4
	elif [ $e -lt 2650 ]; then echo 5
	elif [ $e -lt 2750 ]; then echo 6
	elif [ $e -lt 3450 ]; then echo 7
	elif [ $e -lt 3800 ]; then echo 8
	elif [ $e -lt 4150 ]; then echo 9
	elif [ $e -lt 4750 ]; then echo 10
	elif [ $e -lt 4950 ]; then echo 11
	elif [ $e -ge 5730 ] && [ $e -lt 5850 ]; then echo 17
	elif [ $e -ge 5850 ] && [ $e -lt 6000 ]; then echo 18
	elif [ $e -ge 6000 ] && [ $e -lt 6150 ]; then echo 19
	elif [ $e -ge 6150 ] && [ $e -lt 6450 ]; then echo 20
	elif [ $e -ge 6450 ] && [ $e -lt 6600 ]; then echo 21
	elif [ $e -ge 8690 ] && [ $e -lt 9040 ]; then echo 26
	elif [ $e -ge 9210 ] && [ $e -lt 9660 ]; then echo 28
	elif [ $e -ge 39650 ] && [ $e -lt 41590 ]; then echo 41
	elif [ $e -ge 41590 ] && [ $e -lt 43590 ]; then echo 42
	fi
}

SMS_USED=""; SMS_TOTAL=""

poll_signal() {
	local r reg tac cell rsrp rsrq pci earfcn csq rssi op lvl pdp
	r=$(AT 'AT+CEREG=2;+CEREG?;$QCRSRP?;$QCRSRQ?;+CSQ;+COPS?;+CGPADDR' 3)
	# no final OK = the AT port is not answering (see recover_card)
	echo "$r" | grep -q '^OK$' && POLL_OK=1 || POLL_OK=0
	# +CEREG: 2,<stat>[,"<tac>",...,"<ci>",<act>]; the AMM570 adds a field in between,
	# e.g. +CEREG: 2,1,"9834","2","C012301",7 -> tac = first quoted, ci = last quoted.
	# Only the "+CEREG: 2,<stat>" query reply: CEREG=2 also enables unsolicited
	# "+CEREG: <stat>[,"<tac>",...]" lines, which may arrive in the same read.
	set -- $(echo "$r" | awk -F'"' '/^\+CEREG: *2,[0-9]/ { split($1, a, /[:,]/); n = NF - 1; if (n % 2) n--;
		printf "%s %s %s\n", a[3] + 0, $2, (n >= 4 ? $n : ""); exit }')
	reg=$1; tac=$2; cell=$3
	# $QCRSRP: <pci>,<earfcn>,"<rsrp>"[,...]  first entry = serving cell
	set -- $(echo "$r" | sed -n 's/^\$QCRSRP: *\([0-9]*\),\([0-9]*\),"\([-0-9.]*\)".*/\1 \2 \3/p')
	pci=$1; earfcn=$2; rsrp=$(echo "$3" | sed "s/^-0*\([0-9]\)/-\1/")
	rsrq=$(echo "$r" | sed -n 's/^\$QCRSRQ: *[0-9]*,[0-9]*,"\([-0-9.]*\)".*/\1/p' | sed "s/^-0*\([0-9]\)/-\1/")
	csq=$(echo "$r" | sed -n 's/^+CSQ: *\([0-9]*\),.*/\1/p')
	[ -n "$csq" ] && [ "$csq" -le 31 ] && rssi=$((csq * 2 - 113))
	op=$(echo "$r" | sed -n 's/^+COPS: *[0-9]*,[0-9]*,"\([^"]*\)".*/\1/p')
	# IPv4 addresses of all PDP contexts (the data session's context number is
	# not fixed), space separated
	pdp=$(echo "$r" | sed -n 's/^+CGPADDR: *[0-9]*,"\{0,1\}\([0-9.]*\).*/\1/p' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^0\.0\.0\.0$' | tr '\n' ' ')

	# ANT level 0..5 with the stock adpmgr thresholds (RSRP, CSQ as fallback)
	lvl=0
	if [ "$reg" = 1 ] || [ "$reg" = 5 ]; then
		local a=${rsrp#-}; a=${a%%.*}
		if [ -n "$a" ]; then
			if   [ $a -ge 121 ]; then lvl=0
			elif [ $a -ge 118 ]; then lvl=1
			elif [ $a -ge 113 ]; then lvl=2
			elif [ $a -ge 98 ];  then lvl=3
			elif [ $a -ge 84 ];  then lvl=4
			else lvl=5; fi
		elif [ -n "$csq" ]; then
			if   [ $csq -lt 2 ] || [ $csq -gt 31 ]; then lvl=0
			elif [ $csq -le 4 ];  then lvl=1
			elif [ $csq -le 6 ];  then lvl=2
			elif [ $csq -le 12 ]; then lvl=3
			elif [ $csq -le 19 ]; then lvl=4
			else lvl=5; fi
		fi
	fi

	cat > $RUN/status.new <<EOF
time=$(date +%s)
registered=$reg
operator=$op
rsrp=$rsrp
rsrq=$rsrq
rssi=$rssi
pci=$pci
earfcn=$earfcn
band=$(earfcn_band "$earfcn")
tac=$tac
cell=$cell
level=$lvl
pdp_ip=${pdp% }
imei=$IMEI
revision=$REVISION
sms_used=$SMS_USED
sms_total=$SMS_TOTAL
EOF
	mv $RUN/status.new $RUN/status
}

# SMS receive storage: +CPMS: <mem1>,<u>,<t>,<mem2>,<u>,<t>,<mem3>,<used>,<total>;
# mem3 is where incoming messages are stored (the SIM, "SM", on this card)
poll_sms_usage() {
	set -- $(AT 'AT+CPMS?' | sed -n 's/^+CPMS: *"[A-Z]*",[0-9]*,[0-9]*,"[A-Z]*",[0-9]*,[0-9]*,"[A-Z]*",\([0-9]*\),\([0-9]*\).*/\1 \2/p')
	SMS_USED=$1; SMS_TOTAL=$2
}

# IMEI and firmware revision, read once per card start
read_ident() {
	IMEI=$(AT 'AT+CGSN' | grep -m1 -E '^[0-9]{14,16}$')
	REVISION=$(AT 'AT+CGMR' | grep -v -E '^(OK|AT.*|)$' | head -1 | tr -d '"')
}

# --- connection recovery ------------------------------------------------------
# a) netifd leaves wwan down after a failed setup/teardown and does not retry
#    (seen after ModemManager restarts): registered, ModemManager has the
#    modem, wwan down for 3 polls -> ifup wwan.
# b) ModemManager has no modem for the card although the card answers and is
#    registered (6 polls), or it keeps reporting "connected" while wwan's IPv4
#    is no longer among the card's PDP addresses (2 polls; seen when the card's
#    MBIM channel was closed under it, e.g. by another program opening
#    cdc-wdm directly) -> mm_reset.
# Both back off: 60 s after a recovery, doubling up to 15 min while it does
# not help; reset once the session looks right again.
DOWN=0; BAD=0; NOMODEM=0
LAST_FIX=0; FIX_WAIT=60; FIXED=0

may_fix() { # may_fix -> 0 when the back-off allows another recovery now
	local now=$(date +%s)
	[ $((now - LAST_FIX)) -ge $FIX_WAIT ] || return 1
	[ $FIXED = 1 ] && FIX_WAIT=$((FIX_WAIT * 2))
	[ $FIX_WAIT -le 900 ] || FIX_WAIT=900
	LAST_FIX=$now; FIXED=1
	return 0
}

session_ok() { DOWN=0; BAD=0; NOMODEM=0; FIX_WAIT=60; FIXED=0; }

# Restarting ModemManager alone is not enough after its MBIM channel was
# closed: its probe then fails ("Failed to find primary AT port") until the
# card's MBIM function has seen a clean open/close. So: stop ModemManager and
# its mbim-proxy, open/close MBIM once with umbim, start ModemManager, wait
# for the modem, bring wwan up. Caller must not hold the AT lock.
mm_reset() {
	local i
	/etc/init.d/modemmanager stop
	sleep 2
	kill $(pidof mbim-proxy) 2>/dev/null
	sleep 1
	timeout 15 umbim -t 5 -d /dev/cdc-wdm0 caps >/dev/null 2>&1 || log "MBIM open/close failed"
	/etc/init.d/modemmanager start
	for i in $(seq 1 24); do
		sleep 5
		mmcli -L 2>/dev/null | grep -q '/Modem/' && break
	done
	ifup $IFACE
}

check_session() { # caller holds the AT lock; runs after poll_signal
	local st v4 reg pdp
	reg=$(sed -n 's/^registered=//p' $RUN/status 2>/dev/null)
	[ "$reg" = 1 ] || [ "$reg" = 5 ] || { DOWN=0; BAD=0; NOMODEM=0; return; }
	[ "$(uci -q get network.$IFACE.disabled)" = 1 ] && return
	if ! mmcli -L 2>/dev/null | grep -q '/Modem/'; then
		DOWN=0; BAD=0
		NOMODEM=$((NOMODEM + 1))
		[ $NOMODEM -ge 6 ] && may_fix || return
		NOMODEM=0
		log "ModemManager has no modem although the card is registered, resetting ModemManager"
		at_close; mm_reset
		return
	fi
	NOMODEM=0
	st=$(ifstatus $IFACE 2>/dev/null)
	if [ "$(echo "$st" | jsonfilter -e '@.up')" != true ]; then
		BAD=0
		[ "$(echo "$st" | jsonfilter -e '@.pending')" = true ] && { DOWN=0; return; }
		DOWN=$((DOWN + 1))
		[ $DOWN -ge 3 ] && may_fix || return
		DOWN=0
		log "$IFACE is down while the card is registered, bringing it up"
		ifup $IFACE
		return
	fi
	DOWN=0
	v4=$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].address')
	[ -n "$v4" ] || return	# IPv6-only: nothing to compare
	pdp=$(sed -n 's/^pdp_ip=//p' $RUN/status 2>/dev/null)
	case " $pdp " in *" $v4 "*) session_ok; return ;; esac
	BAD=$((BAD + 1))
	[ $BAD -ge 2 ] && may_fix || return
	BAD=0
	log "data session lost (card '${pdp:-none}', $IFACE '$v4'), resetting ModemManager"
	at_close; mm_reset
}

# The card can drop off USB or stop answering on its AT port; nothing else can
# recover that. After RECOVER_AFTER failed polls in a row (~2.5 min),
# power-cycle it the stock way (um310r-lte-power: power-key pulse, wait for its
# shutdown, cut power, power on). The pause before another cycle doubles each
# time (10 min .. 6 h) and resets once the card has answered for 30 min.
RECOVER_AFTER=12
FAILS=0
RECOVER_WAIT=600
LAST_RECOVER=0

recover_card() {
	local now=$(date +%s)
	[ $((now - LAST_RECOVER)) -ge $RECOVER_WAIT ] || return
	log "card not answering for $FAILS polls, power-cycling it (next cycle not before ${RECOVER_WAIT}s)"
	LAST_RECOVER=$now
	/etc/init.d/um310r-lte-power stop
	sleep 2
	/etc/init.d/um310r-lte-power start
	RECOVER_WAIT=$((RECOVER_WAIT * 2)); [ $RECOVER_WAIT -le 21600 ] || RECOVER_WAIT=21600
	FAILS=0
	sleep 60	# power-on sequence + card boot + USB enumeration
}

daemon() {
	local n=0 ident=""
	rm -f $RUN/status
	while :; do
		POLL_OK=0
		if at_open; then
			[ -n "$ident" ] || { read_ident; ident=1; }
			[ $((n % 6)) = 0 ] && poll_sms_usage
			poll_signal
			[ $POLL_OK = 1 ] && check_session
			at_close
		else
			echo "registered=" > $RUN/status
			ident=""
		fi
		if [ $POLL_OK = 1 ]; then
			FAILS=0
			[ $(( $(date +%s) - LAST_RECOVER )) -lt 1800 ] || RECOVER_WAIT=600
		else
			FAILS=$((FAILS + 1))
			[ $FAILS -lt $RECOVER_AFTER ] || { recover_card; ident=""; }
		fi
		n=$((n + 1))
		sleep 10
	done
}

# --- SMS through ModemManager ---------------------------------------------------
modem() { mmcli -L 2>/dev/null | sed -n 's|.*/Modem/\([0-9]*\) .*|\1|p' | head -1; }

sms_ids() { mmcli -m "$1" --messaging-list-sms 2>/dev/null | sed -n 's|.*/SMS/\([0-9]*\).*|\1|p'; }

sms_send() { # <number> <text>
	local m f r id
	case "$1" in
		''|+|+*[!0-9]*|[!+]*[!0-9]*|[!+0-9]*) echo "invalid number (digits, optional leading +)"; return 1 ;;
	esac
	[ ${#1} -le 21 ] || { echo "invalid number (too long)"; return 1; }
	[ -n "$2" ] || { echo "empty text"; return 1; }
	m=$(modem); [ -n "$m" ] || { echo "no modem (ModemManager)"; return 1; }
	f=$RUN/sms-text.$$
	printf '%s' "$2" > $f
	# the text goes in through a file: any character is fine
	r=$(mmcli -m "$m" --messaging-create-sms="number='$1'" --messaging-create-sms-with-text=$f 2>&1)
	rm -f $f
	id=$(echo "$r" | sed -n 's|.*/SMS/\([0-9]*\).*|\1|p')
	[ -n "$id" ] || { echo "failed: $r"; return 1; }
	r=$(timeout 25 mmcli -s "$id" --send 2>&1)
	mmcli -m "$m" --messaging-delete-sms="$id" >/dev/null 2>&1	# do not keep the sent copy
	echo "$r" | grep -qi 'successfully sent' && { log "SMS sent"; echo OK; return 0; }
	echo "failed: $r"; return 1
}

case "$1" in
	daemon) daemon ;;
	status) cat $RUN/status 2>/dev/null ;;
	sms-list)
		m=$(modem); [ -n "$m" ] || { echo "no modem (ModemManager)"; exit 1; }
		for id in $(sms_ids "$m"); do
			echo "[$id]"; mmcli -s "$id" -K | grep -E 'content\.(number|text)|properties\.(state|timestamp)'
		done ;;
	sms-del)
		case "$2" in all|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]) ;; *) echo "sms-del <id|all>"; exit 1 ;; esac
		m=$(modem); [ -n "$m" ] || { echo "no modem (ModemManager)"; exit 1; }
		ids=$2; [ "$2" = all ] && ids=$(sms_ids "$m")
		rc=0
		for id in $ids; do
			r=$(mmcli -m "$m" --messaging-delete-sms="$id" 2>&1) || { echo "failed: $r"; rc=1; }
		done
		[ $rc = 0 ] && echo OK
		exit $rc ;;
	sms-send)
		[ -n "$2" ] && [ -n "$3" ] || { echo "sms-send <number> <text>"; exit 1; }
		sms_send "$2" "$3" ;;
	*) sed -n '2,19s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
