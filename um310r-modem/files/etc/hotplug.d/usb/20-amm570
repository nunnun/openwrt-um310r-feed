
# AM Telecom AMM570: OpenWrt uses the card in MBIM mode (USB 1ecb:0209,
# cdc_mbim + ModemManager). The stock firmware puts it into ACM/PPP mode
# (1ecb:0202) on every boot, so switch it once when it shows up in ACM mode.
# The setting is stored in the card, which re-enumerates by itself ~10 s later.
# The switch is sent on the ACM data port (ttyACM, interface 0, plain cdc_acm),
# so it needs no USB IDs in the option driver; the option AT port (interface
# 3) is only a fallback. The card enumerates before it accepts AT commands, so
# retry until it answers. Takes the AT lock shared with um310r-modem.
[ "$ACTION" = add ] && [ "$DEVTYPE" = usb_device ] || exit 0
case "$PRODUCT" in 1ecb/202/*) ;; *) exit 0 ;; esac

(
	RUN=/var/run/um310r-modem
	out=/tmp/amm570.at.$$
	mkdir -p $RUN
	for try in $(seq 1 20); do
		[ -d "/sys$DEVPATH" ] || exit 0
		at=""
		for t in /sys$DEVPATH/*:1.0/tty/ttyACM* /sys$DEVPATH/*:1.3/ttyUSB*; do
			[ -e "$t" ] && { at=/dev/${t##*/}; break; }
		done
		if [ -c "$at" ]; then
			# no host-side echo: with card echo on, the two would ping-pong
			stty -F "$at" raw -echo -echoe -echok -echoctl -echoke 115200 2>/dev/null
			exec 9>$RUN/at.lock
			if timeout 30 flock 9 2>/dev/null; then
				(timeout 4 cat "$at" > $out 2>/dev/null) &
				sleep 1
				printf 'ATE0\r' > "$at"; sleep 1
				printf 'AT@USBCHG=MBIM\r' > "$at"
				wait
				flock -u 9
				if grep -q '@USBCHG:MBIM' $out; then
					rm -f $out
					logger -t amm570 "card switched from ACM to MBIM mode via ${at#/dev/} (try $try)"
					exit 0
				fi
			fi
			exec 9>&-
		fi
		sleep 3
	done
	rm -f $out
	logger -t amm570 "could not switch card to MBIM mode"
) &
