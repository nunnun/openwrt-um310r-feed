msgid "AM Telecom AMM570 LTE module. The connection itself is managed by ModemManager (Network > Interfaces > WWAN). Signal values are refreshed every 10 seconds; messages every minute."
msgstr "AM Telecom AMM570 LTE モジュールです。接続そのものは ModemManager が管理します（ネットワーク > インターフェース > WWAN）。電波の状態は 10 秒ごと、SMS は 1 分ごとに更新されます。"

msgid "Band"
msgstr "バンド"

msgid "Delete all messages stored on the modem?"
msgstr "モデムに保存されている SMS をすべて削除しますか？"

msgid "Delete all messages"
msgstr "SMS をすべて削除"

msgid "Delete all"
msgstr "すべて削除"

msgid "Deleting the message failed: %s"
msgstr "SMS を削除できませんでした: %s"

msgid "Deleting the messages failed: %s"
msgstr "SMS を削除できませんでした: %s"

msgid "Denied"
msgstr "登録拒否"

msgid "Enter a phone number (digits, optional leading +)."
msgstr "電話番号を数字で入力してください（先頭に + を付けても構いません）。"

msgid "Excellent"
msgstr "非常に良い"

msgid "Fair"
msgstr "普通"

msgid "Sender"
msgstr "送信元"

msgid "Good"
msgstr "良い"

